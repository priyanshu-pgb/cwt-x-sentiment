# Copy this file to ".env" and fill in your own keys. Never commit .env.

# Apify (live X scraping) - https://console.apify.com/account/integrations
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apidojo/tweet-scraper

# Tavily (recent news search) - https://app.tavily.com
TAVILY_API_KEY=

# Exa (optional alternative news/search source) - https://dashboard.exa.ai
EXA_API_KEY=
